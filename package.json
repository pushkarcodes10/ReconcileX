{
  "name": "reconcile-x",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant transaction reconciliation platform",
  "scripts": {
    "dev": "pnpm --filter @reconcilex/api dev",
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "db:generate": "pnpm --filter @reconcilex/db db:generate",
    "db:migrate": "pnpm --filter @reconcilex/db db:migrate",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@12.16.1"
}
